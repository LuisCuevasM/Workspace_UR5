<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ft300_simple" params="prefix parent">

    <!-- LINK SIMPLE -->
    <link name="${prefix}ft300_link">
      <visual>
        <geometry>
          <cylinder length="0.04" radius="0.035"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder length="0.04" radius="0.035"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- JOINT -->
    <joint name="${prefix}tool0_to_ft" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}ft300_link"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>