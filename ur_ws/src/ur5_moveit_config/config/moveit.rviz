        - /MotionPlanning1/Scene Geometry1
        - /PointCloud21
        - /TF1/Frames1
      Splitter Ratio: 0.5
    Tree Height: 370
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
