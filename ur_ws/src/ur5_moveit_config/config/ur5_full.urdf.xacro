<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_full">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur5_full urdf file -->
    <xacro:include filename="$(find ur5_description)/urdf/ur5_with_hande_visual.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur5_full.ros2_control.xacro" />


    <xacro:ur5_full_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
